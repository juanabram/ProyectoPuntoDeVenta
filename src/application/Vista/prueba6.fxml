<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="720.0" prefWidth="1080.0" spacing="12.0" 
      style="-fx-background-color: #f0f4f9; -fx-font-family: 'Segoe UI', sans-serif;" 
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" 
      >

   <!-- 1. ENCABEZADO HERO INSTITUCIONAL -->
   <HBox alignment="CENTER_LEFT" spacing="18.0" 
         style="-fx-background-color: linear-gradient(to right, #001f4d, #003b80, #0056b3); -fx-padding: 12 24; -fx-background-radius: 0 0 14 14; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.22), 10, 0, 0, 4);">
      
      <!-- Escudo Principal Destacado con Respaldo Circular -->
      <StackPane style="-fx-background-color: #ffffff; -fx-background-radius: 50; -fx-padding: 3; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 8, 0, 0, 2);">
         <ImageView fitHeight="68.0" fitWidth="68.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@CA.jpg" />
            </image>
         </ImageView>
      </StackPane>

      <VBox alignment="CENTER_LEFT" spacing="2.0">
         <Label style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #ffffff; -fx-letter-spacing: 0.8px;" 
                text="SISTEMA DE CONTROL DE ALUMNOS Y MATERIAS" />
         <HBox alignment="CENTER_LEFT" spacing="6.0">
            <ImageView fitHeight="14.0" fitWidth="14.0" opacity="0.85" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@CA.jpg" />
               </image>
            </ImageView>
            <Label style="-fx-font-size: 12px; -fx-text-fill: #bae6fd; -fx-font-weight: bold;" 
                   text="DIRECCIÓN GENERAL ACADÉMICA • CLUB DE FÚTBOL CRUZ AZUL" />
         </HBox>
      </VBox>

      <Region HBox.hgrow="ALWAYS" />

      <!-- Marca de agua decorativa semitransparente -->
      <ImageView fitHeight="56.0" fitWidth="56.0" opacity="0.25" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@CA.jpg" />
         </image>
      </ImageView>
   </HBox>

   <!-- CONTENEDOR CENTRAL DE LA APLICACIÓN -->
   <VBox spacing="12.0" VBox.vgrow="ALWAYS">
      <padding>
         <Insets bottom="8.0" left="16.0" right="16.0" top="2.0" />
      </padding>

      <!-- 2. TARJETA DE FILTROS SUPERIORES -->
      <HBox alignment="CENTER" spacing="24.0" 
            style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #dbeafe; -fx-border-radius: 12; -fx-padding: 14 20; -fx-effect: dropshadow(three-pass-box, rgba(0,43,102,0.07), 8, 0, 0, 2);">
         
         <!-- Filtro Carrera -->
         <VBox alignment="CENTER_LEFT" spacing="6.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@CA.jpg" />
                  </image>
               </ImageView>
               <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1e3a8a;" text="CARRERA PROFESIONAL" />
            </HBox>
            <ComboBox fx:id="CBCarrera" maxWidth="Infinity" prefHeight="42.0" 
                      promptText="Seleccione una carrera..." 
                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #93c5fd; -fx-font-size: 13px;" />
         </VBox>

         <!-- LOGO CENTRAL: Emblema Insignia Expandible -->
         <VBox alignment="CENTER" spacing="4.0" minWidth="130.0" prefWidth="140.0">
            <StackPane style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-border-color: #bfdbfe; -fx-border-radius: 12; -fx-padding: 6; -fx-effect: dropshadow(three-pass-box, rgba(0,43,102,0.12), 6, 0, 0, 2);">
               <ImageView fx:id="imgLogoMedio" fitHeight="76.0" fitWidth="76.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@CA.jpg" />
                  </image>
               </ImageView>
            </StackPane>
            <Label style="-fx-font-size: 9px; -fx-font-weight: 900; -fx-text-fill: #003b80; -fx-letter-spacing: 0.6px;" text="CONTROL ESCOLAR" />
         </VBox>

         <!-- Filtro Periodo -->
         <VBox alignment="CENTER_LEFT" spacing="6.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="6.0">
               <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@CA.jpg" />
                  </image>
               </ImageView>
               <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1e3a8a;" text="CICLO ESCOLAR" />
            </HBox>
            <ListView fx:id="LVPeriodo" maxWidth="Infinity" prefHeight="42.0" 
                      style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #93c5fd; -fx-font-size: 13px;" />
         </VBox>
      </HBox>

      <!-- 3. SECCIÓN DE TABLAS DE DATOS -->
      <HBox spacing="14.0" VBox.vgrow="ALWAYS">
         
         <!-- Tarjeta 1: Alumnos -->
         <VBox spacing="8.0" HBox.hgrow="ALWAYS" 
               style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #dbeafe; -fx-border-radius: 12; -fx-padding: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,43,102,0.06), 8, 0, 0, 2);">
            
            <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 2 4 4 4;">
               <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@CA.jpg" />
                  </image>
               </ImageView>
               <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0f172a;" text="Alumnos Registrados" />
               <Region HBox.hgrow="ALWAYS" />
               <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="Padrón Oficial" />
            </HBox>

            <TableView fx:id="TVAlumnos" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="id" maxWidth="150.0" minWidth="100.0" prefWidth="130.0" text="Matrícula" />
                  <TableColumn fx:id="nombre" minWidth="200.0" prefWidth="280.0" text="Nombre" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </VBox>

         <!-- Tarjeta 2: Materias y Grupos -->
         <VBox spacing="8.0" HBox.hgrow="ALWAYS" 
               style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #dbeafe; -fx-border-radius: 12; -fx-padding: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,43,102,0.06), 8, 0, 0, 2);">
            
            <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 2 4 4 4;">
               <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@CA.jpg" />
                  </image>
               </ImageView>
               <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0f172a;" text="Materias y Grupos Asignados" />
               <Region HBox.hgrow="ALWAYS" />
               <!-- Badge dinámico para mostrar la matrícula seleccionada -->
               <Label fx:id="lblMatriculaSeleccionada" 
                      style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1d4ed8; -fx-background-color: #eff6ff; -fx-border-color: #93c5fd; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 3 10;" 
                      text="Matrícula: Ninguna" />
            </HBox>

            <TableView fx:id="TVMaterias" VBox.vgrow="ALWAYS">
               <!-- Placeholder con Escudo en Marca de Agua cuando la tabla está vacía -->
               <placeholder>
                  <VBox alignment="CENTER" spacing="10.0" opacity="0.6">
                     <ImageView fitHeight="64.0" fitWidth="64.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@CA.jpg" />
                        </image>
                     </ImageView>
                     <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;" 
                            text="Seleccione un alumno de la lista para ver su carga de materias" />
                  </VBox>
               </placeholder>
               <columns>
                  <TableColumn fx:id="colGrupo" maxWidth="90.0" minWidth="65.0" prefWidth="75.0" text="Grupo" />
                  <TableColumn fx:id="colMateria" minWidth="180.0" prefWidth="260.0" text="Nombre de la materia" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </VBox>
      </HBox>

      <!-- 4. FOOTER INSTITUCIONAL -->
      <HBox alignment="CENTER_RIGHT" spacing="10.0" 
            style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-padding: 6 16;">
         
         <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@CA.jpg" />
            </image>
         </ImageView>
         <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;" text="SISTEMA ACADÉMICO INTEGRAL" />
         
         <Region HBox.hgrow="ALWAYS" />
         
         <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="Base de Datos: Access (Database2.accdb) •" />
         <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@CA.jpg" />
            </image>
         </ImageView>
         <Label style="-fx-font-size: 11px; -fx-font-weight: 900; -fx-text-fill: #003b80;" text="CLUB DE FÚTBOL CRUZ AZUL" />
      </HBox>
   </VBox>
</VBox>
